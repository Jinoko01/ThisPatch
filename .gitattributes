# 셸 스크립트는 반드시 LF 여야 한다.
# Windows 에서 클론하면 core.autocrlf 때문에 CRLF 로 받아지고,
# 그러면 WSL 에서 실행할 때 아래처럼 실패한다.
#   bash: ./04-wsl-node.sh: /usr/bin/env^M: bad interpreter
*.sh            text eol=lf
*.bash          text eol=lf

# PowerShell 은 CRLF 가 자연스럽다
*.ps1           text eol=crlf

# 나머지 텍스트는 각자 플랫폼에 맞게
*.py            text
*.sql           text
*.md            text
*.json          text
*.xml           text
*.yml           text
*.yaml          text

# 바이너리 취급
*.png           binary
*.jpg           binary
*.jar           binary
*.tar.gz        binary
*.tgz           binary
